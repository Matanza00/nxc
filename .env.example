# Copy to .env for local use, or add these in Vercel under Settings > Environment Variables.
# Never commit real values.

# Turns on the chat and voice agent. Gemini is used when its key is set, otherwise Claude.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite with Gemini, or claude-opus-5-5 with Claude.
CHAT_MODEL=

# Postgres (for example Neon or Supabase). Turns on the heatmap, the dashboard and saved leads and chats.
DATABASE_URL=

# Password for /admin/, at least 24 characters.
ADMIN_TOKEN=

# Random text used when hashing visitor addresses for rate limits.
RATE_SALT=

# Emails each new brief to the team. Enough on its own for the planner to work, with or without a database.
RESEND_API_KEY=
LEAD_EMAIL=
EMAIL_FROM=
