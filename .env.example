# Copy to .env for local use, or add these in Vercel under Settings > Environment Variables.
# Never commit real values.

# Turns on the chat and voice agent.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
CHAT_MODEL=

# Postgres (for example Neon or Supabase). Turns on the heatmap, leads and saved chats.
DATABASE_URL=

# Password for /admin/, at least 24 characters.
ADMIN_TOKEN=

# Random text used when hashing visitor addresses for rate limits.
RATE_SALT=

# Optional. Emails each new brief to the team.
RESEND_API_KEY=
LEAD_EMAIL=
EMAIL_FROM=
