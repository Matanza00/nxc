// Cloudflare Worker for nxcsol.com. Real files come straight from public/, and every other path runs edge/worker.js.
{
  "name": "nxc",
  "compatibility_date": "2026-11-03",
  "main": "edge/worker.js",
  // keeps the variables set in the Cloudflare dashboard when this deploys
  "keep_vars": true,
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  }
}
