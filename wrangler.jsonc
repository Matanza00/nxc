// Cloudflare Worker for nxcsol.com. Pages come straight from public/, and only /api/* runs edge/worker.js.
{
  "name": "nxc",
  "compatibility_date": "2026-11-03",
  "main": "edge/worker.js",
  // keeps the variables set in the Cloudflare dashboard when this deploys
  "keep_vars": true,
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
